# ===== Telegram =====
# Token gerado no @BotFather
TELEGRAM_BOT_TOKEN=
# IDs numéricos autorizados, separados por vírgula (descubra o seu com o @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=

# ===== LLM =====
# Provedor primário: openai | gemini | deepseek | groq | openai-compatible (padrão: openai)
LLM_PROVIDER=openai
# Opcional: provedor usado quando o primário falha
LLM_FALLBACK_PROVIDER=gemini
# Opcional: provedor do SkillRouter (vazio = mesmo do primário)
ROUTER_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# gpt-5-nano é modelo de raciocínio e não aceita temperature
OPENAI_SUPPORTS_TEMPERATURE=false
# Opcional: proxy corporativo ou Azure OpenAI
OPENAI_BASE_URL=
OPENAI_ORG_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Provedor compatível com OpenAI (LLM local) =====
# Recomendado: Ollama (https://ollama.com) -> ollama pull <modelo>
# Padrão: http://localhost:11434/v1 (Ollama). Outros servidores: ex. LM Studio http://localhost:1234/v1
COMPATIBLE_BASE_URL=http://localhost:11434/v1
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_SUPPORTS_TOOLS=true
COMPATIBLE_SUPPORTS_JSON_MODE=true
COMPATIBLE_SUPPORTS_TEMPERATURE=true
COMPATIBLE_TIMEOUT_MS=300000

# ===== Agente =====
MAX_ITERATIONS=5
MEMORY_WINDOW_SIZE=20
LLM_TIMEOUT_MS=120000
LOG_LEVEL=info
DB_PATH=./data/separadoraudiobot.db

# ===== Áudio =====
# Duração máxima aceita para separação (segundos) e timeout do processo (ms)
AUDIO_SEPARATOR_MAX_SECONDS=900
AUDIO_SEPARATOR_TIMEOUT_MS=3600000
# Modelo do faster-whisper para voice notes: tiny | base | small | medium
WHISPER_MODEL=base
WHISPER_LANGUAGE=pt
WHISPER_TIMEOUT_MS=60000
TTS_VOICE=pt-BR-ThalitaMultilingualNeural
