{
  "name": "separador-audio-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Agente pessoal local via Telegram que separa instrumentos de músicas na CPU.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon",
    "start": "tsx src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup:audio": "bash scripts/setup-audio.sh"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "grammy": "^1.46.0",
    "js-yaml": "^5.5.0",
    "openai": "^7.45.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
